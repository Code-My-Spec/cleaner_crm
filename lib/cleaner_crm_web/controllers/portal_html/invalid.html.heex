<Layouts.app flash={@flash} variant={:public}>
  <div class="max-w-md mx-auto mt-16 text-center">
    <h1 class="text-2xl font-semibold">Link invalid or expired</h1>
    <p class="mt-2 opacity-70">This portal link is invalid or has expired.</p>
    <p class="mt-4">
      <.link navigate={~p"/portal/request-link"} class="link link-primary">Request a new link</.link>
    </p>
  </div>
</Layouts.app>
