<Layouts.app flash={@flash} variant={:public}>
  <div class="mx-auto max-w-xl py-12 text-center">
    <h1 class="text-4xl font-semibold tracking-tight text-balance">Cleaner CRM</h1>
    <p class="mt-4 text-lg text-base-content/70">
      Scheduling, quotes, invoicing, and quality control built for residential cleaning businesses — and a
      client portal your customers will actually use.
    </p>

    <div class="mt-10 flex flex-col items-center gap-3">
      <.link navigate={~p"/book"} class="btn btn-primary btn-lg" data-test="cta-instant-quote">
        Get an instant quote
      </.link>

      <div class="flex flex-wrap justify-center gap-3">
        <.link navigate={~p"/portal"} class="btn btn-ghost" data-test="cta-client-portal">
          Client portal
        </.link>
        <.link navigate={~p"/users/log-in"} class="btn btn-ghost" data-test="cta-business-login">
          Business log in
        </.link>
        <.link navigate={~p"/users/register"} class="btn btn-ghost" data-test="cta-register">
          Register
        </.link>
      </div>

      <.link
        :if={CleanerCrmWeb.Layouts.signed_in_home(@current_scope)}
        navigate={CleanerCrmWeb.Layouts.signed_in_home(@current_scope)}
        class="btn btn-outline mt-4"
        data-test="cta-go-to-app"
      >
        Go to app
      </.link>
    </div>
  </div>
</Layouts.app>
