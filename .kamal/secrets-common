# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process.
#
# This is the SHORT list — Kamal carries only the registry token (for
# image pulls) and the age private key that decrypts envs/<env>.enc.env
# at container boot (rel/overlays/bin/boot). App secrets themselves
# live only in the sops-encrypted envs/*.enc.env files, never here.

KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
SOPS_AGE_KEY=${SOPS_AGE_KEY}
